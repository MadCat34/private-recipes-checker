{
    "name": "madcat34/private-recipes-checker",
    "type": "project",
    "description": "Multi-VCS, multi-registry Symfony Flex recipe checker for private company recipes.",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Fabien Potencier",
            "email": "fabien@symfony.com"
        },
        {
            "name": "Nicolas Grekas",
            "email": "p@tchwork.com"
        },
        {
            "name": "madcat34"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "opis/json-schema": "^2.3",
        "symfony/console": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/process": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/finder": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/var-dumper": "^8.1",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        }
    }
}
